{
  "name": "comment-md",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun --cwd apps/server run dev",
    "dev:web": "bun --cwd apps/web run dev",
    "build:web": "bun --cwd apps/web run build",
    "build:cli": "bun --cwd apps/cli run build",
    "build:server": "bun --cwd apps/server run build",
    "build": "bun run build:web && bun run build:server && bun run build:cli",
    "start": "bun --cwd apps/server run start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "^1.3.14",
    "prisma": "^6.1.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  }
}
