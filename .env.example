# Server / Prisma config used by both `bun --cwd apps/server run dev`
# and `bunx prisma migrate ...`. Copy this file to `.env` and adjust as
# needed. The path is resolved relative to prisma/schema.prisma, so the
# default lands the SQLite file in <repo>/data/comment-md.db.

DATABASE_URL="file:../data/comment-md.db"
HOST="127.0.0.1"
PORT="3210"
